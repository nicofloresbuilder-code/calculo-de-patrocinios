# Copia este archivo a .env.local y llena los valores reales.
# NUNCA commitear .env.local ni pegar estas llaves en código o docs.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo se usa en el servidor (API routes) — nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com)
# Solo se usa en el servidor (API routes) — nunca exponer al cliente
ANTHROPIC_API_KEY=

# Bootstrap de administradores: correos separados por coma que reciben el rol
# SUPER_ADMIN. Resuelve el problema del huevo y la gallina — crear al primer
# administrador antes de que exista la tabla de usuarios.
#
# SIN prefijo NEXT_PUBLIC_ a propósito: se lee solo en el servidor y nunca
# llega al bundle del cliente. Se puede vaciar en cuanto la migración
# 0004_rbac.sql esté aplicada y los roles salgan de la base de datos.
# Ver RBAC-ARCHITECTURE.md §3.
AFORO_SUPER_ADMIN_EMAILS=
